# Exclude top-level paths that were not included in the CE baseline.
/.gitignore
/.semgrepignore
/README.md
/db.sqlite3
/requirements.txt
/static/
/staticfiles/

# In gestionbib, scan only the four baseline files.
/gestionbib/*
!/gestionbib/settings.py
!/gestionbib/urls.py
!/gestionbib/wsgi.py
!/gestionbib/asgi.py

# Exclude generated cache files.
**/__pycache__/
*.pyc
